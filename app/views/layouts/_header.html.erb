<%# これはパーシャル機能を使ってレストフルな環境を作るために作ったファイル
 * このファイルはapplication.html.erbのrenderERBメソッドで読み込まれる%>
<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to "今日の食事決めたろう", root_path, id: "logo" %>
    <nav>
      <ul class="nav navbar-nav navbar-right">
        <li><%= link_to "ホーム", root_path %></li>
        <li><%= link_to "アンケート", form_path %></li>
        <% if user_signed_in? %>
          <li><%= link_to "マイページ", mypage_path %></li>
          <li><%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-logout-button" %></li>
        <% else %>
          <li><%= link_to "ログイン", new_user_session_path %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
