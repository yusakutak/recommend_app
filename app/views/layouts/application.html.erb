<!DOCTYPE html>
<html>
  <%= render "layouts/head" %>
  <body>
   <%= render "layouts/header" %>
    <div class="container">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "warning" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
