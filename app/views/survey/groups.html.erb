<div class="row">
  <div class="col-xs-8">
    <h1 style="text-align:left;">グループ</h1>
    <h2 style="text-align:left;"><%= @groups.size %>グループに参加中</h2>
  </div>
  <div class="col-xs-4 text-right">
    <details>
      <summary class="btn btn-primary">+ 新規作成</summary>
      <div class="app-card" style="text-align:left; margin-top:10px;">
        <%= form_with url: groups_path, method: :post, local: true do |f| %>
          <div class="field">
            <label>グループ名</label>
            <input type="text" name="group[name]" class="form-control" placeholder="例: 大学の友達" required>
          </div>
          <div class="field">
            <label>説明（任意）</label>
            <textarea name="group[description]" class="form-control" placeholder="グループの説明を入力"></textarea>
          </div>
          <div class="field">
            <label>メンバーを招待</label>
            <% if @friends.empty? %>
              <p class="text-muted"><small>招待できるフレンドがいません。先にフレンドを追加してください。</small></p>
            <% else %>
              <% @friends.each do |friend| %>
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="member_ids[]" value="<%= friend.id %>">
                    <%= friend.name %>
                  </label>
                </div>
              <% end %>
            <% end %>
          </div>
          <%= submit_tag "グループを作成", class: "btn btn-primary" %>
        <% end %>
      </div>
    </details>
  </div>
</div>

<% if @groups.empty? %>
  <p class="text-muted">まだ参加しているグループがありません。</p>
<% end %>

<% @groups.each do |group| %>
  <%= link_to group_path(group), class: "app-card", style: "display:block;" do %>
    <strong><%= group.name %></strong>
    <span class="text-muted">（<%= group.users.size %>人）</span>
    <p class="text-muted" style="margin-top:5px;"><%= group.description %></p>
  <% end %>
<% end %>

<%= link_to "マイページへ戻る", mypage_path, class: "btn btn-default" %>
