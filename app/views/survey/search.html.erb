<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold mb-0"><i class="bi bi-search me-2"></i>飲食店検索</h2>
</div>

<!-- 検索フォーム -->
<div class="card mb-4">
  <div class="card-body">
    <%= form_tag search_path, method: :get do %>
      <div class="row g-3 align-items-end">
        <div class="col-md-5">
          <label class="form-label fw-semibold">店名</label>
          <%= text_field_tag :q, @query, class: "form-control", placeholder: "店名で検索..." %>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">ジャンル</label>
          <%= select_tag :genre,
            options_for_select([["すべてのジャンル", ""]] + Genre.all.map { |g| [g.name, g.name] }, @genre),
            class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= submit_tag "検索", class: "btn btn-primary w-100" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- 検索結果 -->
<% if @restaurants %>
  <% if @restaurants.empty? %>
    <div class="text-center py-5">
      <i class="bi bi-emoji-frown display-1 text-muted"></i>
      <p class="text-muted mt-3">検索結果がありません。</p>
    </div>
  <% else %>
    <p class="text-muted mb-3"><strong><%= @restaurants.count %>件</strong>の飲食店が見つかりました</p>
    <div class="row g-3">
      <% @restaurants.each do |restaurant| %>
        <div class="col-md-4">
          <div class="card restaurant-card h-100">
            <div class="card-body">
              <h5 class="card-title">
                <%= link_to restaurant.name, restaurant_path(restaurant), class: "text-decoration-none text-dark" %>
              </h5>
              <span class="badge bg-info text-dark mb-2"><%= restaurant.genre_name %></span>
              <p class="card-text text-muted small">
                <i class="bi bi-geo-alt me-1"></i><%= restaurant.address %>
              </p>
              <% if restaurant.phone.present? %>
                <p class="card-text text-muted small mb-0">
                  <i class="bi bi-telephone me-1"></i><%= restaurant.phone %>
                </p>
              <% end %>
            </div>
            <div class="card-footer bg-transparent">
              <%= link_to "詳細を見る", restaurant_path(restaurant), class: "btn btn-sm btn-outline-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-shop display-1"></i>
    <p class="mt-3">店名やジャンルで飲食店を検索できます</p>
  </div>
<% end %>
