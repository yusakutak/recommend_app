<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>プロフィール編集</h5>
      </div>
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "users/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, "名前", class: "form-label fw-semibold" %>
            <%= f.text_field :name, class: "form-control", autofocus: true, autocomplete: "name" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "メールアドレス", class: "form-label fw-semibold" %>
            <%= f.email_field :email, class: "form-control", autocomplete: "email" %>
          </div>

          <hr>
          <p class="text-muted small">パスワードを変更する場合のみ入力してください</p>

          <div class="mb-3">
            <%= f.label :password, "新しいパスワード", class: "form-label fw-semibold" %>
            <%= f.password_field :password, class: "form-control", autocomplete: "new-password", placeholder: "変更しない場合は空欄" %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "新しいパスワード確認", class: "form-label fw-semibold" %>
            <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
          </div>

          <div class="mb-3">
            <%= f.label :current_password, "現在のパスワード", class: "form-label fw-semibold" %>
            <small class="text-muted">(変更を確定するために必要)</small>
            <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit "更新する", class: "btn btn-primary" %>
            <%= link_to "キャンセル", mypage_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>

        <hr>
        <div>
          <%= button_to "アカウントを削除する", registration_path(resource_name),
              data: { turbo_confirm: "本当にアカウントを削除しますか？この操作は取り消せません。" },
              method: :delete,
              class: "btn btn-outline-danger btn-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
