<% if resource.errors.any? %>
  <div class="alert alert-danger" data-turbo-cache="false">
    <strong><i class="bi bi-exclamation-triangle me-2"></i><%= resource.errors.count %>件のエラーがあります:</strong>
    <ul class="mb-0 mt-2">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
